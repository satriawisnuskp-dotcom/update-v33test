    "SyncCustomLogo": {
      "title": "SyncCustomLogo",
      "description": "Compressed custom icon image payload (Base64) for accounts, assets, and debts synced across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "base64Data": { "type": "string" },
        "updatedAt": { "type": "integer" },
        "isDeleted": { "type": "boolean" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileName", "base64Data", "updatedAt", "isDeleted"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and sync metadata"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/SyncTransaction" },
      "description": "User financial transactions"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/SyncAccount" },
      "description": "User wallets and bank accounts"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/SyncCategory" },
      "description": "User transaction categories"
    },
    "/users/{userId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/SyncDebt" },
      "description": "User debts and receivables"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": { "$ref": "#/entities/SyncAsset" },
      "description": "User investment and cash assets"
    },
    "/users/{userId}/labels/{labelId}": {
      "schema": { "$ref": "#/entities/SyncLabel" },
      "description": "User transaction labels"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/SyncBudget" },
      "description": "User budget allocations"
    },
    "/users/{userId}/recurringTransactions/{recurringId}": {
      "schema": { "$ref": "#/entities/SyncRecurring" },
      "description": "User recurring bills and income"
    },
    "/users/{userId}/financialPlans/{planId}": {
      "schema": { "$ref": "#/entities/SyncFinancialPlan" },
      "description": "User monthly allocation plans"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/SyncEvent" },
      "description": "User events and trips"
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": { "$ref": "#/entities/SyncSavingsGoal" },
      "description": "User savings goals"
    },
    "/users/{userId}/timelineScenarios/{scenarioId}": {
      "schema": { "$ref": "#/entities/SyncTimelineScenario" },
      "description": "User cashflow timeline scenarios"
    },
    "/users/{userId}/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SyncAppSettings" },
      "description": "Full app settings and layout preferences"
    },
    "/users/{userId}/customLogos/{logoId}": {
      "schema": { "$ref": "#/entities/SyncCustomLogo" },
      "description": "Custom account and asset logo binaries"
    }
  }
}
