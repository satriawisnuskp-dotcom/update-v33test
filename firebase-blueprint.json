    "SyncAppSettings": {
      "title": "SyncAppSettings",
      "description": "Full user settings, menu customization, dashboard/statistics order, and active plan state.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "settingsJson": { "type": "string" },
        "activePlanId": { "type": "string" },
