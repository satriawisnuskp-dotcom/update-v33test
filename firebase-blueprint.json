    },
    "SyncSavingsGoal": {
      "title": "SyncSavingsGoal",
      "description": "Savings goal and records synced across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "startDate": { "type": "string" },
        "currency": { "type": "string" },
        "iconName": { "type": "string" },
        "note": { "type": "string" },
        "colorHex": { "type": "integer" },
        "isCompleted": { "type": "boolean" },
        "recordsJson": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "isDeleted": { "type": "boolean" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "targetAmount", "currentAmount", "updatedAt", "isDeleted"]
    },
    "SyncTimelineScenario": {
      "title": "SyncTimelineScenario",
      "description": "Cashflow simulator scenario synced across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "isIncome": { "type": "boolean" },
        "note": { "type": "string" },
        "date": { "type": "string" },
        "recurrence": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "isDeleted": { "type": "boolean" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "amount", "isIncome", "date", "updatedAt", "isDeleted"]
